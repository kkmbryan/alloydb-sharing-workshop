# ===========================================================================
# AlloyDB database flags - production OLTP baseline
# ===========================================================================
#
# How to use this file
#
# This is a reference rather than something you apply directly. Copy the
# values you want into your Terraform `database_flags` map - see
# terraform/examples/02-prod-ha/main.tf for a worked example.
#
# One thing to know if you use gcloud instead:
#
#   `gcloud alloydb instances update --database-flags` replaces the entire
#   flag set. Any flag you leave out quietly returns to its default.
#
# So always send the complete desired set. This is a common way to lose a
# production setting by accident. Terraform's map is declarative and avoids
# the problem, which is a good reason to manage flags there.
#
# About the restart markers
#
# Flags marked RESTART=yes cause an instance restart when changed, which
# closes all open connections. It is worth batching these into a single
# change during a maintenance window. Every restart value below was checked
# against the AlloyDB Admin API supportedDatabaseFlags endpoint on 2026-09-22.
#
# You can pull the authoritative list for your own region with:
#   curl -H "Authorization: Bearer $(gcloud auth print-access-token)" \
#     "https://alloydb.googleapis.com/v1/projects/PROJECT/locations/REGION/supportedDatabaseFlags"
#
# A note on philosophy
#
# AlloyDB tunes more of PostgreSQL for you than a self-managed instance does -
# memory sizing and vacuum scheduling in particular. Many of the flags below
# are therefore commented out on purpose, and the ones left active are mostly
# safety limits rather than performance tuning. Prefer to leave a flag unset
# unless you have measured a reason to change it.
#
# ===========================================================================


# ---------------------------------------------------------------------------
# Connections
# ---------------------------------------------------------------------------

# max_connections                                        RESTART=yes
#   AlloyDB default: 1000. Range: 200 - 240000.
#
#   Best left at the default unless you have measured a reason to change it.
#
#   Google's published guidance table doubles the value with instance size
#   (500, 1000, 2000, 4000) and then plateaus at 5000 for all larger shapes.
#   That plateau is the interesting part: beyond a few thousand, additional
#   connections stop helping. Every connection is a backend process with its
#   own memory, drawn from the same pool that serves the buffer cache.
#
#   If you need to support more clients, a pooler is a better answer than a
#   larger max_connections - and AlloyDB has one built in. See
#   config/connection-pooling/managed-connection-pooling.md.
#
#   Read pool constraint: a read pool's max_connections must be >= the
#   primary's.
#
#   Source: https://cloud.google.com/alloydb/quotas
# max_connections=1000


# ---------------------------------------------------------------------------
# Session hygiene
#
# These give the best return for the least effort in this file.
# ---------------------------------------------------------------------------

# idle_in_transaction_session_timeout                    RESTART=no
#   Milliseconds. 0 disables.
#
#   Worth setting. An idle-in-transaction session holds its locks and pins the
#   vacuum horizon, so a single forgotten psql window can cause table bloat and
#   push transaction ID utilisation up across the whole database.
#
#   60s is strict but reasonable for an OLTP application, since no legitimate
#   web transaction stays open that long. Raise it for batch or ETL work, or
#   better, set it per role:
#       ALTER ROLE etl_user SET idle_in_transaction_session_timeout = '600000';
idle_in_transaction_session_timeout=60000

# statement_timeout                                      RESTART=no
#   Milliseconds. 0 disables.
#
#   Think of this as a backstop rather than a tuning knob. It ensures a single
#   pathological query cannot occupy a connection indefinitely. Set it
#   comfortably above your slowest legitimate query, then tighten per role or
#   per session where you want stricter limits:
#       SET LOCAL statement_timeout = '5s';
statement_timeout=300000

# lock_timeout                                           RESTART=no
#   Milliseconds. Caps how long a statement waits to acquire a lock.
#
#   Particularly useful during migrations. An ALTER TABLE that cannot get its
#   lock will queue behind a long-running read, and every subsequent query
#   then queues behind the ALTER - which is how a quick schema change ends up
#   taking an application down. Set a short lock_timeout in migration sessions
#   and retry on failure.
lock_timeout=10000


# ---------------------------------------------------------------------------
# Memory
#
# AlloyDB sizes the major memory areas from the instance machine shape, and
# those defaults are well matched to the hardware. The flags remain settable,
# but there is usually more to lose than to gain by overriding them.
#
# The one exception worth understanding is work_mem, because its cost scales
# with concurrency rather than being a fixed allocation.
# ---------------------------------------------------------------------------

# work_mem                                               RESTART=no
#   Kilobytes. API-enforced minimum is 64.
#
#   Worth reading carefully before changing. work_mem is allocated per sort or
#   hash operation, per session - not once per instance. A single complex
#   query can use several multiples of it. Total exposure is roughly:
#
#       work_mem  x  concurrent operations  x  concurrent sessions
#
#   Raising this globally to fix one slow report is a well-travelled route to
#   an out-of-memory event. It is safer to raise it only where it is needed:
#       SET LOCAL work_mem = '256MB';   -- inside the reporting transaction
#   or per role, or on an analytics read pool that carries few sessions
#   (see terraform/examples/03-read-pool-scaling).
#
#   Evidence that you need more: temp file spills. Check
#   monitoring/sql/01_top_queries.sql query E, and the metric
#   alloydb.googleapis.com/instance/postgresql/temp_bytes_written_count
# work_mem=4096

# maintenance_work_mem                                   RESTART=no
#   Kilobytes. Used by VACUUM, CREATE INDEX, ALTER TABLE and REINDEX.
#
#   Safer to raise than work_mem because far fewer operations run
#   concurrently. Note that autovacuum workers can each take up to this much,
#   so budget for autovacuum_max_workers x maintenance_work_mem.
#
#   Left commented out: adaptive autovacuum (see below) manages memory for the
#   vacuum process itself, so the main reason to raise this is to speed up
#   manual index builds during a migration window.
# maintenance_work_mem=1048576

# shared_buffers                                         RESTART=yes
#   8kB pages.
#
#   AlloyDB sizes this automatically from the instance shape. It is settable -
#   contrary to a good deal of writing on the subject - but changing it is an
#   expert-level action, and getting it wrong starves either the page cache or
#   the rest of the instance.
#
#   Recommended: leave unset and let AlloyDB scale it with the machine shape.
# shared_buffers=


# ---------------------------------------------------------------------------
# Vacuum and bloat
#
# This section differs from standard PostgreSQL advice, so it is worth reading
# even if you have tuned autovacuum before.
#
# AlloyDB enables adaptive autovacuum by default. Rather than relying on the
# fixed thresholds that stock PostgreSQL uses, it adjusts CPU, I/O, worker
# count and memory for vacuum based on the live workload. It also triggers on
# dead tuple counts and pages needing scan, throttles transaction ID
# consumption to prevent wraparound, and logs the blockers that hold vacuum
# back (long-running transactions, orphaned prepared transactions, orphaned
# replication slots).
#
# The documentation is explicit about what this means for these flags:
#
#   "You do not need to set values in any of these flags for adaptive
#    autovacuum to work because adaptive autovacuum adapts and optimizes its
#    behavior to your real workloads. If you set values in these flags, then
#    adaptive autovacuum adjusts its behavior to take your preferences into
#    account."
#
#   - https://cloud.google.com/alloydb/docs/adaptive-autovacuum
#
# So the classic advice of globally lowering autovacuum_vacuum_scale_factor
# does not transfer to AlloyDB. Every static value you pin here is one signal
# the adaptive logic has to work around. The flags below are therefore left
# commented out by design.
#
# If a specific table genuinely needs more aggressive treatment, prefer a
# per-table setting over a global one:
#     ALTER TABLE orders SET (autovacuum_vacuum_scale_factor = 0.02);
# ---------------------------------------------------------------------------

# enable_google_adaptive_autovacuum                      RESTART=no
#   Values: on | off. Default: on.
#
#   The most important flag in this section. Listed here so it is visible and
#   auditable rather than because it needs changing - leave it on.
#
#   Turn it off only if you have a specific reason to return to stock
#   PostgreSQL autovacuum behaviour, and expect to tune the flags below
#   yourself if you do.
# enable_google_adaptive_autovacuum=on

# alloydb.enable_pg_squeeze                              RESTART=yes
#   Values: on | off. Default: off.
#
#   "Set to on to reduce table and index bloat in a more efficient and less
#    disruptive way as compared to other PostgreSQL bloat reduction methods
#    such as VACUUM."
#   - https://cloud.google.com/alloydb/docs/reference/alloydb-flags
#
#   Worth evaluating for workloads with heavy UPDATE/DELETE churn, where
#   vacuum reclaims space for reuse but does not return it to the filesystem.
#   Enabling it restarts the instance, so batch it with other restart-causing
#   changes. Test on a clone first: it rewrites tables, and takes locks while
#   doing so.
# alloydb.enable_pg_squeeze=on

# The flags below are standard PostgreSQL knobs. Adaptive autovacuum will take
# them into account if set, but none of them need to be set. They are listed
# with their defaults for reference and for the case where you have disabled
# adaptive autovacuum.

# autovacuum_vacuum_scale_factor                         RESTART=no
#   Fraction of the table that must be dead before autovacuum triggers.
#   Stock PostgreSQL default is 0.2. Under adaptive autovacuum this is not the
#   only trigger, so lowering it globally is rarely the win it is on
#   self-managed PostgreSQL.
# autovacuum_vacuum_scale_factor=0.05

# autovacuum_analyze_scale_factor                        RESTART=no
#   Same idea for statistics freshness. Stale statistics cause bad plans, but
#   adaptive autovacuum also updates statistics as part of its own scheduling.
# autovacuum_analyze_scale_factor=0.05

# autovacuum_max_workers                                 RESTART=yes
#   More workers means more tables vacuumed in parallel, at the cost of memory
#   and I/O. Adaptive autovacuum already adjusts the number of vacuum
#   processes to the workload, so raise this only with evidence - see
#   monitoring/sql/03_vacuum_and_bloat.sql query E.
# autovacuum_max_workers=3

# autovacuum_vacuum_cost_limit                           RESTART=no
#   Higher means autovacuum is allowed to do more work before throttling.
#   On self-managed PostgreSQL the conservative default is often the real
#   reason vacuum "is not keeping up". Adaptive autovacuum handles this
#   throttling dynamically, so setting it is usually unnecessary.
# autovacuum_vacuum_cost_limit=2000


# ---------------------------------------------------------------------------
# Logging and observability
# ---------------------------------------------------------------------------

# log_min_duration_statement                             RESTART=no
#   Milliseconds. -1 disables, 0 logs everything.
#
#   1000 catches genuinely slow queries without flooding the log. Avoid
#   setting this to 0 on a busy production instance - you will pay for the
#   logging volume and the signal gets lost in it.
log_min_duration_statement=1000

# log_lock_waits                                         RESTART=no
#   Logs when a session waits longer than deadlock_timeout for a lock.
#   Cheap, and the fastest way to find contention after the fact.
log_lock_waits=on

# log_checkpoints                                        RESTART=no
log_checkpoints=on

# log_temp_files                                         RESTART=no
#   Kilobytes; 0 logs every temp file. These are work_mem spills - exactly the
#   evidence you want before changing work_mem.
log_temp_files=0

# log_connections / log_disconnections                   RESTART=no
#   Valuable for security investigation and for spotting connection churn.
#   These get noisy on a high-churn workload, which is itself a useful finding:
#   it usually means a pooler would help. See
#   config/connection-pooling/managed-connection-pooling.md.
log_connections=on
log_disconnections=on

# log_autovacuum_min_duration                            RESTART=no
#   Milliseconds. Logs autovacuum runs longer than this.
#
#   Keep this on. Adaptive autovacuum writes its blocker warnings to the
#   postgres log, and this is how you see vacuum behaviour over time. It is
#   the first place to look when investigating bloat or wraparound risk.
log_autovacuum_min_duration=10000


# ---------------------------------------------------------------------------
# Security
#
# See docs/security-hardening.md for the full rationale, and
# config/database-flags/security-baseline.env for a security-focused set.
# ---------------------------------------------------------------------------

# alloydb.iam_authentication                             RESTART=no
#   Values: on | off
#   Enables IAM database authentication, removing stored passwords.
#   Confirmed: no restart required.
alloydb.iam_authentication=on

# alloydb.enable_pgaudit                                 RESTART=yes
#   Values: on | off
#   Note that enabling this alone captures nothing, because pgaudit.log
#   defaults to none. Set both.
alloydb.enable_pgaudit=on

# pgaudit.log                                            RESTART=no
#   Allowed: read, write, function, role, ddl, misc, misc_set, all, none
#   plus subtractive forms: -read, -write, ..., -all
#   Combine with commas, e.g. "all,-misc".
#
#   "ddl,role" is high signal and low volume: schema changes and privilege
#   changes. Add "write" when you need data-modification provenance. Reach for
#   "all" only after measuring the log volume it produces.
pgaudit.log=ddl,role

# alloydb.pg_authid_select_role                          RESTART=no
# alloydb.pg_shadow_select_role                          RESTART=no
#   Restrict who may read password hashes from pg_authid / pg_shadow.
#   Without these, any authenticated user can read every hash in the cluster.
alloydb.pg_authid_select_role=alloydbsuperuser
alloydb.pg_shadow_select_role=alloydbsuperuser
