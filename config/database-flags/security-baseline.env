# ===========================================================================
# AlloyDB database flags - security baseline
# ===========================================================================
#
# A hardening-focused flag set for a regulated or security-sensitive
# environment. Layer this on top of production-oltp.env, since this file covers
# only the security-relevant flags.
#
# Every flag name, allowed value and restart requirement below was confirmed
# against the AlloyDB Admin API supportedDatabaseFlags endpoint on 2026-09-22.
#
# A reminder: `gcloud alloydb instances update --database-flags` replaces the
# entire flag set, so send the union of this file and your operational flags.
#
# See docs/04-operations/security-hardening.md for the reasoning, and
# docs/04-operations/audit-logging-and-siem.md for the audit pipeline.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. Identity - removing stored passwords
# ---------------------------------------------------------------------------

# alloydb.iam_authentication                             RESTART=no
#   Values: on | off
#
#   Lets principals authenticate with their Google Cloud identity and a
#   short-lived token instead of a database password. This removes an entire
#   category of risk: there is no long-lived secret to leak, rotate, or find
#   in a config file. Revocation becomes an IAM change that takes effect
#   immediately, rather than a password rotation you have to coordinate.
alloydb.iam_authentication=on

# alloydb.iam_group_authentication                       RESTART=no
#   Values: on | off
#
#   Grant database access to a Google group rather than to individuals.
#   Access then follows the joiner/mover/leaver process you already have,
#   instead of drifting out of sync with it.
alloydb.iam_group_authentication=on


# ---------------------------------------------------------------------------
# 2. Protecting password hashes
# ---------------------------------------------------------------------------

# alloydb.pg_authid_select_role                          RESTART=no
# alloydb.pg_shadow_select_role                          RESTART=no
#
#   In stock PostgreSQL, pg_authid and pg_shadow hold every role's password
#   hash. These flags restrict SELECT on them to a named role.
#
#   Without this, any authenticated database user can read every password
#   hash in the cluster and take them away for offline cracking. For a
#   security team this is usually the single most surprising finding in a
#   default PostgreSQL configuration.
alloydb.pg_authid_select_role=alloydbsuperuser
alloydb.pg_shadow_select_role=alloydbsuperuser


# ---------------------------------------------------------------------------
# 3. Password policy
#
# Applies to built-in (non-IAM) users. You should have very few of these -
# ideally only a break-glass account - but that account is exactly the one
# worth protecting.
# ---------------------------------------------------------------------------

# All password.* flags are RESTART=no.

password.enforce_complexity=on
password.min_pass_length=16
password.max_pass_length=100

password.min_uppercase_letters=1
password.min_lowercase_letters=1
password.min_numerical_chars=1
password.min_special_chars=1

# Reject passwords containing the username - a common weak pattern.
password.enforce_password_does_not_contain_username=on

# Expiry. Note that modern guidance (NIST SP 800-63B) argues against forced
# periodic rotation for user passwords, because it drives predictable
# increments. Enable it only where a compliance regime requires it, and
# prefer IAM authentication so the question does not arise.
password.enforce_expiration=on
password.expiration_in_days=90
password.notify_expiration_in_days=14


# ---------------------------------------------------------------------------
# 4. Audit logging
# ---------------------------------------------------------------------------

# alloydb.enable_pgaudit                                 RESTART=YES
#   Values: on | off
#
#   Loads the pgaudit extension. Two further steps are needed before you get
#   any output:
#     1. set pgaudit.log below (it defaults to none)
#     2. run `CREATE EXTENSION IF NOT EXISTS pgaudit;` in EACH database
#   And separately, enable Data Access audit logs on alloydb.googleapis.com
#   at the project level, or the records are never delivered.
alloydb.enable_pgaudit=on

# pgaudit.log                                            RESTART=no
#   Allowed: read, write, function, role, ddl, misc, misc_set, all, none
#   Subtractive: -read, -write, -function, -role, -ddl, -misc, -misc_set, -all
#   Combine with commas.
#
#   Choose deliberately. Volume is the thing that kills audit projects:
#
#     ddl,role        schema and privilege changes. High signal, low volume.
#                     The right starting point for almost everyone.
#     ddl,role,write  adds INSERT/UPDATE/DELETE provenance. Moderate volume.
#     all,-misc       everything except miscellaneous commands. HIGH volume -
#                     every SELECT on a busy OLTP database. Measure before
#                     committing to this.
pgaudit.log=ddl,role,write

# pgaudit.log_parameter                                  RESTART=no
#   Records actual parameter VALUES, not just the statement shape.
#
#   High forensic value: "who read which customer record", rather than merely "someone
#   ran a SELECT". But it means audit logs now contain the sensitive data
#   itself, so the log sink becomes a sensitive data store and must be
#   protected and access-controlled accordingly.
pgaudit.log_parameter=on

# pgaudit.log_relation                                   RESTART=no
#   Emits a separate entry per relation touched. Makes "what was accessed"
#   queryable instead of requiring SQL parsing at analysis time.
pgaudit.log_relation=on

# pgaudit.log_catalog                                    RESTART=no
#   Auditing catalog reads is very noisy - every client tool introspects the
#   catalog on connect. Leave off unless investigating a specific incident.
pgaudit.log_catalog=off

# pgaudit.log_client                                     RESTART=no
#   Echo audit records to the connected client. Useful for debugging the
#   audit configuration; never leave on in production.
pgaudit.log_client=off

# pgaudit.role                                           RESTART=no
#   Enables OBJECT-LEVEL auditing, which is the most precise tool here.
#
#   Create an auditor role, point this flag at it, then grant that role
#   privileges on the tables you care about. Any access to those objects is
#   then audited regardless of who performs it:
#
#       CREATE ROLE auditor NOLOGIN;
#       GRANT SELECT, INSERT, UPDATE, DELETE ON pii.customers TO auditor;
#
#   This gives you targeted, low-volume auditing of exactly the sensitive
#   tables, rather than auditing everything and filtering later.
# pgaudit.role=auditor

# alloydb.enable_auditlog_volume_reduction               RESTART=YES
#   Deduplicates repetitive audit records within a window. Meaningfully
#   reduces volume and cost on workloads that execute the same statement
#   shapes at high rate.
alloydb.enable_auditlog_volume_reduction=on

# pgaudit.auditlog_volume_reduction_window               RESTART=no
#   Deduplication window. Longer means less volume but coarser timing
#   resolution in the audit trail. Confirm this is acceptable to whoever owns
#   your audit requirements before increasing it.
# pgaudit.auditlog_volume_reduction_window=60


# ---------------------------------------------------------------------------
# 5. Session and connection hygiene
# ---------------------------------------------------------------------------

# Bound how long an abandoned or hijacked session can stay useful.
idle_in_transaction_session_timeout=60000
statement_timeout=300000
lock_timeout=10000

# Connection provenance for investigations. Noisy, but this is a security
# baseline - you want the record.
log_connections=on
log_disconnections=on

# Log every failed statement. Repeated failures are a signal: enumeration
# attempts, SQL injection probing, or a broken deployment.
log_min_error_statement=error

# Capture lock waits - useful both for performance work and for spotting
# unusual access patterns.
log_lock_waits=on


# ---------------------------------------------------------------------------
# 6. Not flags, but part of the baseline
#
# These are instance or cluster settings, not database flags. They are listed
# here so the baseline reads as one complete control set.
#
#   ssl_mode                    = ENCRYPTED_ONLY
#   require_connectors          = true
#   enable_public_ip            = false
#   authorized_external_networks = []
#   encryption_config.kms_key_name = <CMEK key>
#
#   Project level:
#     Data Access audit logs enabled on alloydb.googleapis.com
#     Log sink to a separate security project
#     Org policy: constraints/gcp.restrictNonCmekServices denies alloydb
#
# See terraform/examples/04-secure-cmek-psc/ for all of this as code.
# ---------------------------------------------------------------------------
